# Ruta base pública. Ej: /mapa/ para publicar en https://ejemplo.cl/mapa/
# Dejar vacío para publicar en la raíz del dominio.
ASTRO_BASE=

# URL canónica del sitio, sin barra final. Ej: https://recursos.ejemplo.cl
ASTRO_SITE=http://localhost:4321

# Proveedor de teselas (por defecto OpenStreetMap). Respetar la política de uso del proveedor.
PUBLIC_TILE_URL=https://tile.openstreetmap.org/{z}/{x}/{y}.png
PUBLIC_TILE_ATTRIBUTION=&copy; colaboradores de <a href="https://www.openstreetmap.org/copyright">OpenStreetMap</a>
PUBLIC_TILE_MAX_ZOOM=19

# Modo experimental de edición vía API de GitHub. Desactivado en esta versión.
PUBLIC_ADMIN_GITHUB=false
