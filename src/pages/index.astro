---
import Base from '../layouts/Base.astro';
import AlertasChips from '../components/AlertasChips.astro';
import Mapa from '../components/Mapa.astro';
import TarjetaRecurso from '../components/TarjetaRecurso.astro';
import {
  alertasCriticas,
  recursos,
  site,
  tipoDe,
  tipos,
  trasladosProximos,
  zonas,
  zonasGeo,
  zonasVisibles,
} from '../lib/content';
import { aVista } from '../lib/vista';

const vistas = recursos.map((recurso) => aVista(recurso, tipoDe(recurso), site));
const alertas = alertasCriticas();
const traslados = trasladosProximos();

const zonaNombre = (id: string | undefined): string | undefined =>
  id === undefined ? undefined : zonas.find((zona) => zona.id === id)?.nombre;
---

<Base
  titulo={site.titulo}
  descripcion={
    site.subtitulo ?? 'Recursos de emergencia en el mapa, con estado y hora de actualización.'
  }
  tituloPropio
>
  <h1 class="solo-lector">{site.titulo}</h1>

  <div class="shell">
    <AlertasChips alertas={alertas} traslados={traslados} />
  </div>

  <div class="shell">
    <Mapa recursos={vistas} tipos={tipos} zonas={zonasVisibles} zonasGeo={zonasGeo} site={site} />
  </div>

  <section class="shell" style="margin-top:var(--space-5)" aria-labelledby="recursos-titulo">
    <div class="seccion-cabecera">
      <h2 id="recursos-titulo">Recursos visibles</h2>
      <span class="seccion-cabecera__conteo" id="conteo-tarjetas">
        {recursos.length} {recursos.length === 1 ? 'recurso' : 'recursos'}
      </span>
    </div>

    <ul class="lista-tarjetas">
      {recursos.map((recurso) => (
        <TarjetaRecurso
          recurso={recurso}
          tipo={tipoDe(recurso)}
          zonaNombre={zonaNombre(recurso.zona)}
        />
      ))}
    </ul>

    <p id="sin-tarjetas" class="frescura" hidden>
      Ningún recurso coincide con la búsqueda.
    </p>
  </section>
</Base>
