---
import Base from '../layouts/Base.astro';
import BadgeEstado from '../components/BadgeEstado.astro';
import AvisoFrescura from '../components/AvisoFrescura.astro';
import {
  recursos,
  site,
  tipoDe,
  zonas,
  requerimientos,
  zonasGeo,
  tiposPorId,
} from '../lib/content';
import { conBase } from '../lib/rutas';
import { ultimaActualizacion } from '../lib/recurso';

const zonaNombre = (id: string | undefined): string | undefined =>
  id === undefined ? undefined : zonas.find((zona) => zona.id === id)?.nombre;

const filas = recursos.map((recurso) => ({
  recurso,
  tipo: tipoDe(recurso),
  zona: zonaNombre(recurso.zona),
  actualizado: ultimaActualizacion(recurso),
}));

const requerimientosVisibles = requerimientos.filter(
  (requerimiento) => requerimiento.estado !== 'cubierto',
);

const prioridadLegible: Record<string, string> = {
  baja: 'Baja',
  media: 'Media',
  alta: 'Alta',
  critica: 'Crítica',
};

const estadoRequerimientoLegible: Record<string, string> = {
  abierto: 'Abierto',
  asignado: 'Asignado',
  cubierto: 'Cubierto',
};

const geometriaLegible: Record<string, string> = {
  punto: 'Punto',
  linea: 'Línea',
  poligono: 'Polígono',
};
---

<Base
  titulo="Lista de recursos"
  descripcion="Lista completa de recursos de emergencia con estado, ubicación y hora de actualización. Funciona sin mapa y sin JavaScript."
>
  <div class="shell" style="padding-block:var(--space-5);max-width:58rem">
    <div class="seccion-cabecera">
      <h1 style="font-size:var(--text-lg)">Recursos</h1>
      <span class="seccion-cabecera__conteo">
        {recursos.length} {recursos.length === 1 ? 'publicado' : 'publicados'}
      </span>
    </div>

    <p class="frescura" style="margin-bottom:var(--space-4)">
      Ordenados por tipo. Toca un recurso para ver su ficha completa.
    </p>

    <ul class="lista-compacta">
      {filas.map(({ recurso, tipo, zona, actualizado }) => (
        <li>
          <a class="fila-recurso" href={conBase(`/recurso/${recurso.id}`)}>
            <span
              class="fila-recurso__punto"
              style={`background:${tipo.color}`}
              aria-hidden="true"
            />
            <span>
              <span class="fila-recurso__nombre">{recurso.nombre}</span>
              <span class="fila-recurso__meta">
                <span>{tipo.etiqueta}</span>
                {zona && <span>{zona}</span>}
              </span>
            </span>
            <span class="fila-recurso__derecha">
              <BadgeEstado estado={recurso.estado_actual} />
              <AvisoFrescura fecha={actualizado} compacto />
            </span>
          </a>
        </li>
      ))}
    </ul>

    <p class="frescura" style="margin-top:var(--space-4)">
      Umbral de desactualización: {site.umbral_desactualizado_horas} h. Pasado ese plazo, la ficha
      lo advierte.
    </p>

    {requerimientosVisibles.length > 0 && (
      <section style="margin-top:var(--space-6)" aria-labelledby="necesidades-titulo">
        <h2 id="necesidades-titulo" style="font-size:var(--text-md)">
          Necesidades abiertas
        </h2>
        <ul class="lista-compacta">
          {requerimientosVisibles.map((requerimiento) => (
            <li>
              <div class="fila-recurso" style="cursor:default">
                <span
                  class="fila-recurso__punto"
                  style="background:var(--accent)"
                  aria-hidden="true"
                />
                <span>
                  <span class="fila-recurso__nombre">{requerimiento.nombre}</span>
                  <span class="fila-recurso__meta">
                    <span>{requerimiento.cantidad} unidades</span>
                    <span>
                      Prioridad{' '}
                      {prioridadLegible[requerimiento.prioridad] ?? requerimiento.prioridad}
                    </span>
                    <span>{requerimiento.ubicacion.nombre}</span>
                    {requerimiento.asignado_a && (
                      <span>
                        Asignado a{' '}
                        <a href={conBase(`/recurso/${requerimiento.asignado_a}`)}>
                          {requerimiento.asignado_a}
                        </a>
                      </span>
                    )}
                  </span>
                </span>
                <span class="fila-recurso__derecha">
                  <span
                    class={`badge ${requerimiento.estado === 'abierto' ? 'badge--alerta' : 'badge--neutral'}`}
                  >
                    {estadoRequerimientoLegible[requerimiento.estado] ?? requerimiento.estado}
                  </span>
                </span>
              </div>
            </li>
          ))}
        </ul>
      </section>
    )}

    {zonasGeo.length > 0 && (
      <section style="margin-top:var(--space-6)" aria-labelledby="zonas-titulo">
        <h2 id="zonas-titulo" style="font-size:var(--text-md)">
          Zonas y cortes
        </h2>
        <ul class="lista-compacta">
          {zonasGeo.map((zona) => (
            <li>
              <div class="fila-recurso" style="cursor:default">
                <span
                  class="fila-recurso__punto"
                  style={`background:${tiposPorId.get(zona.tipo)?.color ?? 'var(--ink-3)'}`}
                  aria-hidden="true"
                />
                <span>
                  <span class="fila-recurso__nombre">{zona.nombre}</span>
                  <span class="fila-recurso__meta">
                    <span>{tiposPorId.get(zona.tipo)?.etiqueta ?? zona.tipo}</span>
                    <span>{geometriaLegible[zona.geometria.tipo] ?? zona.geometria.tipo}</span>
                    {zona.zona && <span>{zonaNombre(zona.zona)}</span>}
                  </span>
                </span>
              </div>
            </li>
          ))}
        </ul>
      </section>
    )}
  </div>
</Base>
