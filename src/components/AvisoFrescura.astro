---
import { site } from '../lib/content';
import { etiquetaFrescura, formatearRelativa, formatearRelativaCorta } from '../lib/tiempo';

interface Props {
  fecha: string;
  /** Compacto para tarjetas: solo "hace 2 horas", sin fecha absoluta. */
  compacto?: boolean;
}

const { fecha, compacto = false } = Astro.props;
const etiqueta = etiquetaFrescura(fecha, site.umbral_desactualizado_horas);
const relativa = compacto ? formatearRelativaCorta(fecha) : formatearRelativa(fecha);
const texto = compacto ? relativa : `Actualizado ${relativa}`;
const prefijo = compacto ? '' : 'Actualizado';
---

<span
  class:list={['frescura', etiqueta.desactualizado && 'frescura--vencida']}
  data-frescura
  data-fecha={fecha}
  data-umbral={site.umbral_desactualizado_horas}
  data-prefijo={prefijo}
  data-corta={compacto ? 'true' : 'false'}
>
  <span data-frescura-texto>{texto}</span>
  {!compacto && (
    <>
      {' · '}
      <time datetime={fecha}>{etiqueta.absoluta}</time>
    </>
  )}
  {compacto && (
    <time class="solo-lector" datetime={fecha}>
      {etiqueta.absoluta}
    </time>
  )}
  {etiqueta.desactualizado && (
    <span class="solo-lector">. La información puede estar desactualizada.</span>
  )}
</span>
