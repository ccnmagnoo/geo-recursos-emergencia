---
import type { RecursoVista } from '../lib/vista';
import type { SiteT, TipoRecursoT, ZonaT, ZonaGeoT } from '../lib/schema';
import { conBase } from '../lib/rutas';
import { atribucionTeselas } from '../lib/url';
import MuestraTipo from './MuestraTipo.astro';

interface Props {
  recursos: RecursoVista[];
  tipos: TipoRecursoT[];
  zonas: ZonaT[];
  zonasGeo: ZonaGeoT[];
  site: SiteT;
}

const { recursos, tipos, zonas, zonasGeo, site } = Astro.props;

/** Solo se ofrecen filtros de tipos que tienen al menos un recurso publicado. */
const tiposConRecursos = tipos
  .filter((tipo) => recursos.some((recurso) => recurso.tipo.id === tipo.id))
  .sort((a, b) => a.orden - b.orden);

const zonasGeoVista = zonasGeo
  .map((zona) => {
    const tipo = tipos.find((candidato) => candidato.id === zona.tipo);
    if (tipo === undefined) return null;
    return {
      id: zona.id,
      nombre: zona.nombre,
      tipo: tipo.id,
      etiqueta: tipo.etiqueta,
      color: tipo.color,
      geometria: {
        tipo: zona.geometria.tipo,
        coordenadas: zona.geometria.coordenadas,
      },
      detalles: Object.entries(zona.detalles).map(([clave, valor]) => ({ clave, valor })),
    };
  })
  .filter((zona): zona is NonNullable<typeof zona> => zona !== null);

const datos = {
  centro: { lat: site.mapa.centro_lat, lng: site.mapa.centro_lng, zoom: site.mapa.zoom },
  teselas: {
    url: site.teselas.url,
    atribucion: atribucionTeselas(site.teselas.atribucion, site.teselas.atribucion_url),
    maxZoom: site.teselas.max_zoom,
  },
  umbralHoras: site.umbral_desactualizado_horas,
  recursos,
  zonasGeo: zonasGeoVista,
};

/** Evita cerrar el <script> si un texto contiene "</script>". */
const json = JSON.stringify(datos).replaceAll('<', '\\u003c');

const estados = [
  { valor: 'operativo', texto: 'Funcionando' },
  { valor: 'con_falla', texto: 'Con falla' },
  { valor: 'fuera_de_servicio', texto: 'Fuera de servicio' },
  { valor: 'en_traslado', texto: 'En traslado' },
  { valor: 'planificado', texto: 'Planificado' },
  { valor: 'retirado', texto: 'Retirado' },
];
---

<section class="mapa-hero" aria-labelledby="titulo-mapa">
  <h2 class="solo-lector" id="titulo-mapa">
    Mapa de recursos de emergencia
  </h2>

  <div class="mapa-barra">
    <div class="campo">
      <label class="solo-lector" for="busqueda">
        Buscar recursos
      </label>
      <input
        type="search"
        id="busqueda"
        name="busqueda"
        autocomplete="off"
        placeholder="Buscar agua, albergue, sector…"
      />
    </div>
    <button
      type="button"
      class="boton boton--secundario mapa-barra__filtros"
      id="alternar-filtros"
      aria-expanded="false"
      aria-controls="panel-filtros"
    >
      Filtros
    </button>
    <p class="mapa-barra__resultado" role="status" aria-atomic="true" id="resultado-mapa">
      {recursos.length} recursos
    </p>
  </div>

  <div id="panel-filtros" class="panel-filtros" hidden>
    <div style="display:grid;grid-template-columns:1fr 1fr;gap:var(--space-3)">
      <div class="campo">
        <label for="filtro-estado">Estado</label>
        <select id="filtro-estado" name="estado">
          <option value="">Todos</option>
          {estados.map((estado) => (
            <option value={estado.valor}>{estado.texto}</option>
          ))}
        </select>
      </div>

      <div class="campo">
        <label for="filtro-zona">Zona</label>
        <select id="filtro-zona" name="zona">
          <option value="">Todas</option>
          {zonas.map((zona) => (
            <option value={zona.id}>
              {zona.comuna ? `${zona.nombre} (${zona.comuna})` : zona.nombre}
            </option>
          ))}
        </select>
      </div>
    </div>

    <div class="panel-filtros__grupo">
      <h3>Tipo de recurso</h3>
      <fieldset>
        <legend class="solo-lector">Filtrar por tipo de recurso</legend>
        {tiposConRecursos.map((tipo) => (
          <label class="check">
            <input type="checkbox" name="tipo" value={tipo.id} checked />
            <MuestraTipo tipo={tipo} tamano="pequeno" />
            <span>{tipo.etiqueta}</span>
          </label>
        ))}
      </fieldset>
    </div>

    <div style="display:flex;flex-wrap:wrap;gap:var(--space-2)">
      <label class="check">
        <input type="checkbox" id="mostrar-traslados" checked />
        <span>Traslados</span>
      </label>
      <label class="check">
        <input type="checkbox" id="mostrar-zonas" checked />
        <span>Zonas y cortes</span>
      </label>
    </div>

    <div class="panel-filtros__pie">
      <button type="button" class="boton boton--fantasma" id="limpiar-filtros">
        Limpiar
      </button>
      <button type="button" class="boton boton--secundario" id="cerrar-filtros">
        Listo
      </button>
    </div>
  </div>

  <div
    id="mapa"
    class="mapa"
    role="region"
    aria-label="Mapa interactivo de recursos. Si no puedes usar el mapa, abre la lista de recursos."
  ></div>

  <dialog class="ficha" id="ficha-mapa" aria-labelledby="ficha-mapa-titulo">
    <div class="ficha__barra">
      <h2 id="ficha-mapa-titulo" style="margin:0;font-size:var(--text-base)">
        Ficha del recurso
      </h2>
      <button type="button" class="boton boton--icono" data-cerrar-ficha style="margin-left:auto">
        <span aria-hidden="true">✕</span>
        <span class="solo-lector">Cerrar ficha</span>
      </button>
    </div>
    <div class="ficha__cuerpo" id="ficha-mapa-cuerpo"></div>
  </dialog>

  <script type="application/json" id="datos-mapa" set:html={json}></script>
</section>

<noscript>
  <div class="shell" style="padding-block:var(--space-3)">
    <p class="aviso aviso--info" style="display:block">
      El mapa necesita JavaScript. La <a href={conBase('/lista')}>lista de recursos</a> funciona sin
      conexión y sin JavaScript.
    </p>
  </div>
</noscript>

<script>
  import '../scripts/mapa';
</script>
