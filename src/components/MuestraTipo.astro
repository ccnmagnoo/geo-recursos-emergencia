---
import type { TipoRecursoT } from '../lib/schema';
import IconoRecurso from './IconoRecurso.astro';

interface Props {
  tipo: TipoRecursoT;
  tamano?: 'normal' | 'pequeno';
}

const { tipo, tamano = 'normal' } = Astro.props;
const pequeno = tamano === 'pequeno';
---

<span
  class:list={['icono-teja', pequeno && 'icono-teja--sm']}
  style={`--color-tipo:${tipo.color}`}
  aria-hidden="true"
>
  <IconoRecurso icono={tipo.icono} tamano={pequeno ? 15 : 18} />
</span>
