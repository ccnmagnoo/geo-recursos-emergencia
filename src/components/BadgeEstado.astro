---
import type { EstadoRecurso } from '../lib/schema';
import { etiquetaEstado, tonoEstado } from '../lib/recurso';

interface Props {
  estado: EstadoRecurso;
  /** Texto adicional para lectores de pantalla. */
  contexto?: string;
}

const { estado, contexto } = Astro.props;
const tono = tonoEstado(estado);
---

<span class={`badge badge--${tono}`}>
  <span aria-hidden="true">
    {tono === 'ok' ? '✓' : tono === 'falla' ? '✕' : tono === 'alerta' ? '!' : '·'}
  </span>
  {etiquetaEstado(estado)}
  {contexto && <span class="solo-lector">, {contexto}</span>}
</span>
