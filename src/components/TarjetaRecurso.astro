---
import type { RecursoT, TipoRecursoT } from '../lib/schema';
import { conBase } from '../lib/rutas';
import { ultimaActualizacion } from '../lib/recurso';
import { urlComoLlegar } from '../lib/url';
import BadgeEstado from './BadgeEstado.astro';
import AvisoFrescura from './AvisoFrescura.astro';
import MuestraTipo from './MuestraTipo.astro';

interface Props {
  recurso: RecursoT;
  tipo: TipoRecursoT;
  zonaNombre?: string;
}

const { recurso, tipo, zonaNombre } = Astro.props;
const frescura = ultimaActualizacion(recurso);
const llegada = urlComoLlegar(
  recurso.ubicacion_actual.gmaps_url,
  recurso.ubicacion_actual.lat,
  recurso.ubicacion_actual.lng,
);
const ficha = conBase(`/recurso/${recurso.id}`);
---

<li class="tarjeta">
  <div class="tarjeta__cabecera">
    <MuestraTipo tipo={tipo} tamano="pequeno" />
    <h3 class="tarjeta__titulo">{recurso.nombre}</h3>
    <BadgeEstado estado={recurso.estado_actual} />
  </div>

  <p class="tarjeta__meta">
    <span>{tipo.etiqueta}</span>
    {zonaNombre && <span>{zonaNombre}</span>}
    <span>{recurso.institucion}</span>
  </p>

  <p class="tarjeta__meta">
    <span>{recurso.ubicacion_actual.nombre}</span>
    <AvisoFrescura fecha={frescura} compacto />
  </p>

  <div class="tarjeta__acciones">
    <a class="boton boton--secundario" href={ficha}>
      Ver ficha<span class="solo-lector"> de {recurso.nombre}</span>
    </a>
    <a class="boton" href={llegada.href} target="_blank" rel="noopener noreferrer">
      Cómo llegar
      <span class="solo-lector"> a {recurso.ubicacion_actual.nombre} en Google Maps</span>
    </a>
  </div>
</li>
